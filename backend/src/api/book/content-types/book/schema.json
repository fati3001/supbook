{
  "kind": "collectionType",
  "collectionName": "books",
  "info": {
    "singularName": "book",
    "pluralName": "books",
    "displayName": "book"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "isbn": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "year": {
      "type": "integer"
    },
    "reading_status": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "to_read",
        "reading",
        "finished"
      ]
    },
    "rating": {
      "type": "integer"
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author",
      "inversedBy": "books"
    },
    "library_collections": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::library-collection.library-collection",
      "inversedBy": "books"
    },
    "review": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::review.review",
      "inversedBy": "book"
    },
    "users_permissions_user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}
